+	if(avail >= need)
+		return ARCHIVE_OK;
+
+	if(!rar5->datacrypt.ctx_valid) {
+		if(archive_decrypto_aes_cbc_init(&rar5->datacrypt.ctx,
+		    rar5->datacrypt.key, sizeof(rar5->datacrypt.key),
+		    rar5->datacrypt.iv) != 0) {
