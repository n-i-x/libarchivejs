+	if(!rar5->datacrypt.active)
+		return ARCHIVE_OK;
+	rest = rar5->datacrypt.enc_remaining;
+	rar5_datacrypt_end(rar5);
+	rar5->file.bytes_remaining = 0;
+
+	if(rest > 0 && rest != __archive_read_consume(a, rest))
+		return ARCHIVE_FATAL;
+
+	return ARCHIVE_OK;
