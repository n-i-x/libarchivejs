+/*
+ * Decode one PPMd symbol, or one escape sequence, into the LZSS window.
+ *
+ * This used to live in read_data_compressed, which decoded a symbol and copied
+ * it out straight away. That had no place for filters: a PPMd block that
+ * defined one (escape code 3) failed with "Parsing filters is unsupported",
+ * and run_filters, which decodes up to the end of a filter block through
+ * expand(), stopped short at the first PPMd block. Decoding here lets expand()
+ * run straight through PPMd data, so filter bookkeeping is the same for both
+ * block types.
+ *
+ * End of PPMd data sets ppmd_eod and pulls *end back to the current position.
+ */
+static int
+expand_ppmd(struct archive_read *a, int64_t *end)
+{
+  struct rar *rar = a->format->data;
+  int sym, code, length, i;
+  int lzss_offset;
+
+  if ((sym = __archive_ppmd7_functions.Ppmd7_DecodeSymbol(
+    &rar->ppmd7_context, &rar->range_dec.p)) < 0)
+    goto bad_symbol;
+  if (sym != rar->ppmd_escape)
+  {
+    lzss_emit_literal(rar, sym);
+    return (ARCHIVE_OK);
+  }
+
+  if ((code = __archive_ppmd7_functions.Ppmd7_DecodeSymbol(
+    &rar->ppmd7_context, &rar->range_dec.p)) < 0)
+    goto bad_symbol;
+
+  switch(code)
+  {
+    case 0:
+      /* New tables: the next block may be LZSS or PPMd. */
+      {
+        int r = parse_codes(a);
+        return (r < ARCHIVE_WARN ? r : ARCHIVE_OK);
+      }
+
+    case 2:
+      rar->ppmd_eod = 1;/* End Of ppmd Data. */
+      *end = lzss_position(&rar->lzss);
+      return (ARCHIVE_OK);
+
+    case 3:
+      /* A filter, coded as in an LZSS block but read through the model. */
+      if (!read_filter(a, end))
+      {
+        archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+                          "Bad RAR file data");
+        return (ARCHIVE_FAILED);
+      }
+      return (ARCHIVE_OK);
+
+    case 4:
+      lzss_offset = 0;
+      for (i = 2; i >= 0; i--)
+      {
+        if ((code = __archive_ppmd7_functions.Ppmd7_DecodeSymbol(
+          &rar->ppmd7_context, &rar->range_dec.p)) < 0)
+          goto bad_symbol;
+        lzss_offset |= code << (i * 8);
+      }
+      if ((length = __archive_ppmd7_functions.Ppmd7_DecodeSymbol(
+        &rar->ppmd7_context, &rar->range_dec.p)) < 0)
+        goto bad_symbol;
+      lzss_emit_match(rar, lzss_offset + 2, length + 32);
+      return (ARCHIVE_OK);
+
+    case 5:
+      if ((length = __archive_ppmd7_functions.Ppmd7_DecodeSymbol(
+        &rar->ppmd7_context, &rar->range_dec.p)) < 0)
+        goto bad_symbol;
+      lzss_emit_match(rar, 1, length + 4);
+      return (ARCHIVE_OK);
+
+    default:
+      lzss_emit_literal(rar, sym);
+      return (ARCHIVE_OK);
+  }
+
+bad_symbol:
+  archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+                    "Invalid symbol");
+  return (ARCHIVE_FAILED);
+}
