 	int64_t last_size;           /* Used in sanity checks. */
 
@@ -2091,7 +2093,7 @@ static int process_head_file_extra(struct archive_read* a,
 
 static int file_entry_sanity_checks(struct archive_read* a,
 	size_t block_flags, uint8_t is_dir, uint64_t unpacked_size,
-	size_t packed_size)
+	uint64_t packed_size)
 {
 	if (is_dir) {
 		const int declares_data_size =
@@ -2120,7 +2122,7 @@ static int process_head_file(struct archive_read* a, struct rar5 *rar5,
     struct archive_entry* entry, size_t block_flags)
 {
 	int64_t extra_data_size = 0;
-	size_t data_size = 0;
+	uint64_t data_size = 0;
 	size_t file_flags = 0;
 	size_t file_attr = 0;
 	size_t compression_info = 0;
@@ -2169,17 +2171,19 @@ static int process_head_file(struct archive_read* a, struct rar5 *rar5,
 	}
 
 	if(block_flags & HFL_DATA) {
-		if(!read_var_sized(a, &data_size, NULL))
+		/* read_var, not read_var_sized: size_t would truncate the
+		 * value on a 32-bit target. */
+		if(!read_var(a, &data_size, NULL))
 			return ARCHIVE_EOF;
 
-		if(data_size > SSIZE_MAX) {
+		if(data_size > INT64_MAX) {
 			archive_set_error(&a->archive,
 			    ARCHIVE_ERRNO_FILE_FORMAT,
 			    "File data size is too large");
 			return ARCHIVE_FATAL;
 		}
 
-		rar5->file.bytes_remaining = data_size;
+		rar5->file.bytes_remaining = (int64_t) data_size;
 	} else {
 		rar5->file.bytes_remaining = 0;
 	}
@@ -2410,7 +2414,13 @@ static int process_head_file(struct archive_read* a, struct rar5 *rar5,
 	}
 
 	if((file_flags & UNKNOWN_UNPACKED_SIZE) == 0) {
-		rar5->file.unpacked_size = (ssize_t) unpacked_size;
+		if(unpacked_size > INT64_MAX) {
+			archive_set_error(&a->archive,
