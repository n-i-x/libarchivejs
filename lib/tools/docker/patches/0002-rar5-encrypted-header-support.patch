+/* Largest KDF shift accepted. RAR stores the iteration count as a shift, so an
+ * absurd value would otherwise turn opening an archive into a denial of
+ * service. Real archives use 15 (32768 iterations). */
+#define RAR5_MAX_KDF_SHIFT 24
+#define RAR5_CRYPT_BLOCK   16
+/*
+ * Zero padding kept past the end of a decrypted header. read_var() asks for 10
+ * bytes to decode a value that is often a single byte, which the stream always
+ * satisfies from whatever follows, but a buffer holding exactly one header
+ * cannot. Serving those over-reads out of a zero filled tail keeps the vint
+ * decoder happy -- a zero byte terminates a value -- while consume() still
+ * refuses to move the cursor past the real end of the header.
+ */
+#define RAR5_HDR_SLACK     16
+/*
+ * Upper bound on passphrase attempts. A registered passphrase list runs out on
+ * its own -- next_passphrase() returns NULL once every candidate has failed --
+ * but a caller that installs a passphrase *callback* (bsdtar prompting on a
+ * terminal, say) can keep handing back new ones forever, so the loop needs its
+ * own ceiling to stay finite.
+ */
+#define RAR5_MAX_PASSPHRASE_TRIES 100
