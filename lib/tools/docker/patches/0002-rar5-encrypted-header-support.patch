+/* Decode a RAR5 variable sized value straight out of a buffer. read_var()
+ * cannot be used for this: it reads through the stream, and the bytes being
+ * decoded here have only just been decrypted into memory. */
+static int
+rar5_vint_buf(const uint8_t* p, size_t avail, uint64_t* pvalue, size_t* plen)
+{
+	uint64_t result = 0;
+	size_t i;
+
+	for(i = 0; i < avail && i < 10; i++) {
+		result |= (uint64_t)(p[i] & 0x7f) << (7 * i);
+		if((p[i] & 0x80) == 0) {
+			*pvalue = result;
+			*plen = i + 1;
+			return 1;
+		}
+	}
+
+	return 0;
+}
+
+/* Read `n` bytes out of the stream into a caller supplied buffer. */
+static int
+rar5_read_exact(struct archive_read* a, uint8_t* dst, size_t n)
+{
+	const uint8_t* p;
+
+	if(!read_ahead(a, n, &p))
+		return 0;
+	memcpy(dst, p, n);
+	return consume(a, (int64_t)n) == ARCHIVE_OK;
+}
+
+/*
+ * Derive the archive key from the passphrase, and check it against the
+ * password verification value when the archive carries one.
+ *
+ * Both come from the same PBKDF2-HMAC-SHA256 chain over (passphrase, salt):
+ * the key is the value after `1 << kdf_count` iterations, while the check
+ * value is the value 32 iterations further on, folded from 32 bytes down to 8
+ * by XOR. Checking it means a wrong passphrase is reported as such, instead of
+ * surfacing later as unreadable garbage.
+ */
+static int
+rar5_derive_key(struct archive_read* a, struct rar5* rar5, const char* pw,
+    const uint8_t* check_value, int have_check)
+{
+	uint8_t hash[32], check[8];
+	unsigned rounds;
+	size_t i;
+	int ret;
+
+	if(rar5->hdrcrypt.kdf_count > RAR5_MAX_KDF_SHIFT) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+		    "Unsupported RAR5 KDF count");
+		return ARCHIVE_FATAL;
+	}
+	rounds = 1U << rar5->hdrcrypt.kdf_count;
+
+	ret = archive_pbkdf2_sha256(pw, strlen(pw), rar5->hdrcrypt.salt,
+	    sizeof(rar5->hdrcrypt.salt), rounds, rar5->hdrcrypt.key,
+	    sizeof(rar5->hdrcrypt.key));
+	if(ret != 0) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    ret == CRYPTOR_STUB_FUNCTION
+			? "Decryption is unsupported due to lack of crypto library"
+			: "Failed to derive the archive key");
+		return ARCHIVE_FATAL;
+	}
+
+	if(!have_check)
+		return ARCHIVE_OK;
+
+	if(archive_pbkdf2_sha256(pw, strlen(pw), rar5->hdrcrypt.salt,
+	    sizeof(rar5->hdrcrypt.salt), rounds + 32, hash, sizeof(hash)) != 0) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "Failed to derive the password check value");
+		return ARCHIVE_FATAL;
+	}
+
+	memset(check, 0, sizeof(check));
+	for(i = 0; i < sizeof(hash); i++)
+		check[i & (sizeof(check) - 1)] ^= hash[i];
+
+	if(memcmp(check, check_value, sizeof(check)) != 0) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "Incorrect passphrase");
+		return ARCHIVE_FAILED;
+	}
+
+	return ARCHIVE_OK;
+}
+
+/*
+ * Pull one encrypted header block off the stream and decrypt it into
+ * rar5->hdrcrypt.buf, leaving read_ahead()/consume() serving from there.
+ *
+ * The block's own length is inside the ciphertext, so this happens in two
+ * steps: decrypt the leading block to read the CRC and the header size, then
+ * decrypt the whole thing -- from the same IV, since CBC state cannot be
+ * rewound -- and hide the padding by reporting only the real header length.
+ */
+static int
+rar5_read_encrypted_header(struct archive_read* a, struct rar5* rar5)
+{
+	const uint8_t* p;
+	uint8_t iv[RAR5_CRYPT_BLOCK], probe[RAR5_CRYPT_BLOCK];
+	archive_cbc_ctx ctx;
+	uint64_t raw_hdr_size;
+	size_t hdr_size_len, plain_len, total, out_len;
+	int ret;
+
+	if(!rar5_read_exact(a, iv, sizeof(iv)))
+		return ARCHIVE_EOF;
+
+	if(!read_ahead(a, sizeof(probe), &p))
+		return ARCHIVE_EOF;
+
+	if(archive_decrypto_aes_cbc_init(&ctx, rar5->hdrcrypt.key,
+	    sizeof(rar5->hdrcrypt.key), iv) != 0) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "Failed to initialize header decryption");
+		return ARCHIVE_FATAL;
+	}
+	out_len = sizeof(probe);
+	ret = archive_decrypto_aes_cbc_update(&ctx, p, sizeof(probe), probe,
+	    &out_len);
+	archive_decrypto_aes_cbc_release(&ctx);
+	if(ret != 0) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "Failed to decrypt the block header");
+		return ARCHIVE_FATAL;
+	}
+
+	/* 4 byte CRC, then the header size as a variable sized value. A vint is
+	 * at most 10 bytes, so it always lies inside this first block. */
+	if(!rar5_vint_buf(probe + 4, sizeof(probe) - 4, &raw_hdr_size,
+	    &hdr_size_len)) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+		    "Invalid encrypted block header");
+		return ARCHIVE_FATAL;
+	}
+
+	plain_len = 4 + hdr_size_len + (size_t)raw_hdr_size;
+	if(raw_hdr_size == 0 || plain_len > (2 * 1024 * 1024)) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+		    "Invalid encrypted block header size");
+		return ARCHIVE_FATAL;
+	}
+
+	total = ((plain_len + RAR5_CRYPT_BLOCK - 1) / RAR5_CRYPT_BLOCK) *
+	    RAR5_CRYPT_BLOCK;
+
+	if(rar5->hdrcrypt.buf_cap < total + RAR5_HDR_SLACK) {
+		uint8_t* nb = realloc(rar5->hdrcrypt.buf,
+		    total + RAR5_HDR_SLACK);
+		if(nb == NULL) {
+			archive_set_error(&a->archive, ENOMEM,
+			    "Cannot allocate memory for a decrypted header");
+			return ARCHIVE_FATAL;
+		}
+		rar5->hdrcrypt.buf = nb;
+		rar5->hdrcrypt.buf_cap = total + RAR5_HDR_SLACK;
+	}
+
+	if(!read_ahead(a, total, &p))
+		return ARCHIVE_EOF;
+
+	if(archive_decrypto_aes_cbc_init(&ctx, rar5->hdrcrypt.key,
+	    sizeof(rar5->hdrcrypt.key), iv) != 0) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "Failed to initialize header decryption");
+		return ARCHIVE_FATAL;
+	}
+	out_len = total;
+	ret = archive_decrypto_aes_cbc_update(&ctx, p, total,
+	    rar5->hdrcrypt.buf, &out_len);
+	archive_decrypto_aes_cbc_release(&ctx);
+	if(ret != 0 || out_len < plain_len) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "Failed to decrypt the block header");
+		return ARCHIVE_FATAL;
+	}
+
+	/* Anything past the header itself -- the encryption padding, then the
+	 * slack -- must read as zeroes, so an over-read cannot pick up
+	 * ciphertext-derived garbage and decode it as a value. */
+	memset(rar5->hdrcrypt.buf + plain_len, 0,
+	    rar5->hdrcrypt.buf_cap - plain_len);
+
+	/* Step over the encrypted block in the real stream BEFORE redirecting,
+	 * because consume() honours the serving flag and would otherwise just
+	 * move the buffer cursor and leave the stream parked on the ciphertext. */
+	if(consume(a, (int64_t)total) != ARCHIVE_OK)
+		return ARCHIVE_EOF;
+
+	/* The padding is not part of the header and must not be visible to the
+	 * parsers, which would otherwise read past its end. */
+	rar5->hdrcrypt.buf_len = plain_len;
+	rar5->hdrcrypt.buf_pos = 0;
+	rar5->hdrcrypt.serving = 1;
+
+	return ARCHIVE_OK;
+}
