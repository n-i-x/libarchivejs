+/*
+ * HEAD_CRYPT describes how the rest of the archive is encrypted. It is itself
+ * in the clear -- it has to be, since it carries the salt needed to derive the
+ * key -- and every block after it is encrypted.
+ */
+static int
+process_head_crypt(struct archive_read* a, struct rar5* rar5)
+{
+	size_t version = 0, enc_flags = 0;
+	uint8_t kdf_count = 0;
+	uint8_t check_value[12];
+	int have_check, ret, tries, tried_one = 0;
+
+	if(!read_var_sized(a, &version, NULL))
+		return ARCHIVE_EOF;
+	if(version != 0) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+		    "Unsupported RAR5 encryption version: %d", (int)version);
+		return ARCHIVE_FATAL;
+	}
+	if(!read_var_sized(a, &enc_flags, NULL))
+		return ARCHIVE_EOF;
+	if(!rar5_read_exact(a, &kdf_count, 1))
+		return ARCHIVE_EOF;
+	if(!rar5_read_exact(a, rar5->hdrcrypt.salt,
+	    sizeof(rar5->hdrcrypt.salt)))
+		return ARCHIVE_EOF;
+
+	have_check = (enc_flags & 0x01) != 0;
+	if(have_check &&
+	    !rar5_read_exact(a, check_value, sizeof(check_value)))
+		return ARCHIVE_EOF;
+
+	rar5->hdrcrypt.kdf_count = kdf_count;
+
+	/* Rewind the passphrase iterator before using it: it starts parked on
+	 * "no candidate", so the first next() call returns NULL until reset. */
+	__archive_read_reset_passphrase(a);
+
+	/* Walk the passphrases the caller offers, stopping at the first one the
+	 * check value accepts. Without a check value the first is taken on
+	 * trust, and a wrong one shows up as a header CRC error further on. */
+	for(tries = 0; tries < RAR5_MAX_PASSPHRASE_TRIES; tries++) {
+		const char* pw = __archive_read_next_passphrase(a);
+
+		/* NULL means the candidate list is exhausted; empty means a
+		 * callback had nothing to give (a prompt with no terminal). */
+		if(pw == NULL || pw[0] == '\0')
+			break;
+
+		tried_one = 1;
+		ret = rar5_derive_key(a, rar5, pw, check_value, have_check);
+		if(ret == ARCHIVE_OK) {
+			rar5->hdrcrypt.enabled = 1;
+			return ARCHIVE_OK;
+		}
+		/* Anything other than a rejected passphrase is terminal. */
+		if(ret != ARCHIVE_FAILED)
+			return ret;
+	}
+
+	/* Fatal rather than failed: with the headers encrypted and no key,
+	 * there is nothing further that can be read from this archive, and
+	 * carrying on would only produce bogus entries and CRC errors. */
+	archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+	    tried_one ? "Incorrect passphrase"
+		      : "Passphrase required for this archive");
+	return ARCHIVE_FATAL;
+}
