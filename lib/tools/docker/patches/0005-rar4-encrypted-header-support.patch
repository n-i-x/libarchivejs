+/* Try one password against the CRC stored inside an encrypted header. */
+static int
+rar4_header_try_password(struct archive_read *a, struct rar *rar,
+    const uint8_t salt[8], const char *password, size_t *cipher_len)
+{
+  archive_cbc_ctx ctx = NULL;
+  const uint8_t *cipher;
+  uint8_t key[16], iv[16], first[RAR4_CRYPT_BLOCK];
+  size_t header_size, padded_size, out_len;
+  uint32_t crc;
+  int ret;
+
+  if (rar4_derive_key(password, salt, 8, key, iv) != 0)
+    return ARCHIVE_RETRY;
+  cipher = __archive_read_ahead(a, RAR4_CRYPT_BLOCK, NULL);
+  if (cipher == NULL)
+    return ARCHIVE_RETRY;
+
+  ret = archive_decrypto_aes_cbc_init(&ctx, key, sizeof(key), iv);
+  if (ret != 0) {
+    archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+        ret == CRYPTOR_STUB_FUNCTION
+          ? "Decryption is unsupported due to lack of crypto library"
+          : "Failed to initialize RAR4 header decryption");
+    return ARCHIVE_FATAL;
+  }
+  out_len = sizeof(first);
+  ret = archive_decrypto_aes_cbc_update(&ctx, cipher,
+      RAR4_CRYPT_BLOCK, first, &out_len);
+  archive_decrypto_aes_cbc_release(&ctx);
+  if (ret != 0 || out_len != sizeof(first))
+    return ARCHIVE_RETRY;
+
+  header_size = archive_le16dec(first + 5);
+  if (header_size < 7 || header_size > RAR4_MAX_HEADER)
+    return ARCHIVE_RETRY;
+  padded_size = (header_size + RAR4_CRYPT_BLOCK - 1) &
+      ~(size_t)(RAR4_CRYPT_BLOCK - 1);
+  cipher = __archive_read_ahead(a, padded_size, NULL);
+  if (cipher == NULL)
+    return ARCHIVE_RETRY;
+
+  if (rar->hdrcrypt.buf_cap < padded_size) {
+    uint8_t *newbuf = realloc(rar->hdrcrypt.buf, padded_size);
+    if (newbuf == NULL) {
+      archive_set_error(&a->archive, ENOMEM,
+          "Cannot allocate memory for decrypted RAR4 header");
+      return ARCHIVE_FATAL;
+    }
+    rar->hdrcrypt.buf = newbuf;
+    rar->hdrcrypt.buf_cap = padded_size;
+  }
+
+  ret = archive_decrypto_aes_cbc_init(&ctx, key, sizeof(key), iv);
+  memset(key, 0, sizeof(key));
+  memset(iv, 0, sizeof(iv));
+  if (ret != 0) {
+    archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+        "Failed to initialize RAR4 header decryption");
+    return ARCHIVE_FATAL;
+  }
+  out_len = padded_size;
+  ret = archive_decrypto_aes_cbc_update(&ctx, cipher, padded_size,
+      rar->hdrcrypt.buf, &out_len);
+  archive_decrypto_aes_cbc_release(&ctx);
+  if (ret != 0 || out_len != padded_size)
+    return ARCHIVE_RETRY;
+
+  crc = crc32(0, rar->hdrcrypt.buf + 2, (unsigned)header_size - 2);
+  if ((crc & 0xffff) != archive_le16dec(rar->hdrcrypt.buf))
+    return ARCHIVE_RETRY;
+
+  rar->hdrcrypt.buf_len = header_size;
+  rar->hdrcrypt.buf_pos = 0;
+  *cipher_len = padded_size;
+  return ARCHIVE_OK;
+}
+
+/*
+ * RAR4 -hp encrypts every header after MAIN_HEAD independently. Each block
+ * starts with an eight-byte salt and its ciphertext is rounded up to the AES
+ * block size. Decrypt the complete header so its encoded size can be hidden
+ * too, then let the existing parser consume it through the wrappers below.
+ */
+static int
+rar4_header_prepare(struct archive_read *a, struct rar *rar)
+{
+  const uint8_t *p;
+  uint8_t salt[8];
+  const char *password;
+  size_t cipher_len = 0;
+  unsigned tries = 0;
+  int ret = ARCHIVE_RETRY;
+
+  if (!rar->hdrcrypt.enabled || rar->hdrcrypt.serving)
+    return ARCHIVE_OK;
+  p = __archive_read_ahead(a, sizeof(salt), NULL);
+  if (p == NULL)
+    return ARCHIVE_EOF;
+  memcpy(salt, p, sizeof(salt));
+  if (__archive_read_consume(a, sizeof(salt)) != (int64_t)sizeof(salt))
+    return ARCHIVE_FATAL;
+
+  if (rar->hdrcrypt.password != NULL) {
+    ret = rar4_header_try_password(a, rar, salt,
+        rar->hdrcrypt.password, &cipher_len);
+  } else {
+    __archive_read_reset_passphrase(a);
+    while (tries++ < RAR4_MAX_PASSPHRASE_TRIES &&
+        (password = __archive_read_next_passphrase(a)) != NULL) {
+      if (password[0] == '\0')
+        continue;
+      ret = rar4_header_try_password(a, rar, salt, password, &cipher_len);
+      if (ret == ARCHIVE_OK) {
+        rar->hdrcrypt.password = strdup(password);
+        if (rar->hdrcrypt.password == NULL) {
+          archive_set_error(&a->archive, ENOMEM,
+              "Cannot cache verified RAR4 passphrase");
+          return ARCHIVE_FATAL;
+        }
+        break;
+      }
+      if (ret == ARCHIVE_FATAL)
+        return ret;
+    }
+  }
+
+  if (ret != ARCHIVE_OK) {
+    archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+        tries <= 1 && rar->hdrcrypt.password == NULL
+          ? "Passphrase required for encrypted RAR4 headers"
+          : "Incorrect passphrase or corrupt encrypted RAR4 header");
+    return ARCHIVE_FATAL;
+  }
+  if (__archive_read_consume(a, (int64_t)cipher_len) !=
+      (int64_t)cipher_len)
+    return ARCHIVE_FATAL;
+  rar->hdrcrypt.serving = 1;
+  return ARCHIVE_OK;
+}
+
+static const void *
+rar4_header_ahead(struct archive_read *a, size_t min, ssize_t *avail)
+{
+  struct rar *rar = a->format->data;
+  size_t remaining;
+
+  if (!rar->hdrcrypt.serving)
+    return __archive_read_ahead(a, min, avail);
+  remaining = rar->hdrcrypt.buf_len - rar->hdrcrypt.buf_pos;
+  if (min > remaining)
+    return NULL;
+  if (avail != NULL)
+    *avail = (ssize_t)remaining;
+  return rar->hdrcrypt.buf + rar->hdrcrypt.buf_pos;
+}
+
+static int64_t
+rar4_header_consume(struct archive_read *a, int64_t count)
+{
+  struct rar *rar = a->format->data;
+  size_t remaining;
+  int64_t consumed;
+
+  if (!rar->hdrcrypt.serving)
+    return __archive_read_consume(a, count);
+  if (count < 0)
+    return -1;
+  remaining = rar->hdrcrypt.buf_len - rar->hdrcrypt.buf_pos;
+  if ((uint64_t)count <= remaining) {
+    rar->hdrcrypt.buf_pos += (size_t)count;
+    if (rar->hdrcrypt.buf_pos == rar->hdrcrypt.buf_len)
+      rar->hdrcrypt.serving = 0;
+    return count;
+  }
+
+  rar->hdrcrypt.buf_pos = rar->hdrcrypt.buf_len;
+  rar->hdrcrypt.serving = 0;
+  consumed = __archive_read_consume(a, count - (int64_t)remaining);
+  if (consumed < 0)
+    return consumed;
+  return (int64_t)remaining + consumed;
+}
