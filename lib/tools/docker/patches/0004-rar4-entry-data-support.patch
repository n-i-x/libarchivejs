+/*
+ * RAR3's key derivation is based on SHA-1, but it also preserves a bug in the
+ * old RAR implementation: full input blocks are overwritten with the final
+ * sixteen words of the SHA-1 message schedule and reused on later rounds.
+ * A regular SHA-1 API cannot reproduce that behavior, so keep the small
+ * compatible implementation here. The SHA-1 algorithm itself is public
+ * domain (Steve Reid's implementation is the historical reference used by
+ * UnRAR).
+ */
+struct rar4_sha1 {
+  uint32_t state[5];
+  uint64_t count;
+  uint8_t buffer[64];
+};
+
+static uint32_t
+rar4_rol32(uint32_t v, unsigned n)
+{
+  return (v << n) | (v >> (32 - n));
+}
+
+static void
+rar4_sha1_transform(uint32_t state[5], const uint8_t block[64],
+    uint8_t *mutated)
+{
+  uint32_t w[16];
+  uint32_t a, b, c, d, e, f, k, temp;
+  unsigned i;
+
+  for (i = 0; i < 16; i++)
+    w[i] = archive_be32dec(block + i * 4);
+
+  a = state[0];
+  b = state[1];
+  c = state[2];
+  d = state[3];
+  e = state[4];
+  for (i = 0; i < 80; i++) {
+    if (i >= 16)
+      w[i & 15] = rar4_rol32(w[(i + 13) & 15] ^ w[(i + 8) & 15] ^
+          w[(i + 2) & 15] ^ w[i & 15], 1);
+    if (i < 20) {
+      f = (b & (c ^ d)) ^ d;
+      k = 0x5a827999;
+    } else if (i < 40) {
+      f = b ^ c ^ d;
+      k = 0x6ed9eba1;
+    } else if (i < 60) {
+      f = ((b | c) & d) | (b & c);
+      k = 0x8f1bbcdc;
+    } else {
+      f = b ^ c ^ d;
+      k = 0xca62c1d6;
+    }
+    temp = rar4_rol32(a, 5) + f + e + k + w[i & 15];
+    e = d;
+    d = c;
+    c = rar4_rol32(b, 30);
+    b = a;
+    a = temp;
+  }
+
+  state[0] += a;
+  state[1] += b;
+  state[2] += c;
+  state[3] += d;
+  state[4] += e;
+
+  if (mutated != NULL) {
+    for (i = 0; i < 16; i++)
+      archive_le32enc(mutated + i * 4, w[i]);
+  }
+}
+
+static void
+rar4_sha1_init(struct rar4_sha1 *ctx)
+{
+  ctx->count = 0;
+  ctx->state[0] = 0x67452301;
+  ctx->state[1] = 0xefcdab89;
+  ctx->state[2] = 0x98badcfe;
+  ctx->state[3] = 0x10325476;
+  ctx->state[4] = 0xc3d2e1f0;
+}
+
+static void
+rar4_sha1_process(struct rar4_sha1 *ctx, uint8_t *data, size_t len,
+    int mutate)
+{
+  size_t i, j = (size_t)(ctx->count & 63);
+
+  ctx->count += len;
+  if (j + len > 63) {
+    i = 64 - j;
+    memcpy(ctx->buffer + j, data, i);
+    rar4_sha1_transform(ctx->state, ctx->buffer, NULL);
+    for (; i + 63 < len; i += 64)
+      rar4_sha1_transform(ctx->state, data + i,
+          mutate ? data + i : NULL);
+    j = 0;
+  } else {
+    i = 0;
+  }
+  if (len > i)
+    memcpy(ctx->buffer + j, data + i, len - i);
+}
+
+static void
+rar4_sha1_done(struct rar4_sha1 *ctx, uint32_t digest[5])
+{
+  uint64_t bit_length = ctx->count * 8;
+  unsigned pos = (unsigned)(ctx->count & 63);
+  unsigned i;
+
+  ctx->buffer[pos++] = 0x80;
+  if (pos > 56) {
+    memset(ctx->buffer + pos, 0, 64 - pos);
+    rar4_sha1_transform(ctx->state, ctx->buffer, NULL);
+    pos = 0;
+  }
+  memset(ctx->buffer + pos, 0, 56 - pos);
+  archive_be64enc(ctx->buffer + 56, bit_length);
+  rar4_sha1_transform(ctx->state, ctx->buffer, NULL);
+  for (i = 0; i < 5; i++)
+    digest[i] = ctx->state[i];
+}
+
+/* Convert the API's UTF-8 passphrase to the UTF-16LE bytes used by RAR3. */
+static int
+rar4_password_bytes(const char *password, uint8_t raw[254], size_t *raw_len)
+{
+  const uint8_t *p = (const uint8_t *)password;
+  size_t units = 0;
+
+  while (*p != 0 && units < 127) {
+    uint32_t cp;
+    size_t n;
+
+    if (p[0] < 0x80) {
+      cp = p[0]; n = 1;
+    } else if ((p[0] & 0xe0) == 0xc0 && p[1] != 0) {
+      cp = ((uint32_t)(p[0] & 0x1f) << 6) | (p[1] & 0x3f); n = 2;
+      if ((p[1] & 0xc0) != 0x80 || cp < 0x80) return -1;
+    } else if ((p[0] & 0xf0) == 0xe0 && p[1] != 0 && p[2] != 0) {
+      cp = ((uint32_t)(p[0] & 0x0f) << 12) |
+          ((uint32_t)(p[1] & 0x3f) << 6) | (p[2] & 0x3f); n = 3;
+      if ((p[1] & 0xc0) != 0x80 || (p[2] & 0xc0) != 0x80 ||
+          cp < 0x800 || (cp >= 0xd800 && cp <= 0xdfff)) return -1;
+    } else if ((p[0] & 0xf8) == 0xf0 && p[1] != 0 && p[2] != 0 &&
+        p[3] != 0) {
+      cp = ((uint32_t)(p[0] & 7) << 18) |
+          ((uint32_t)(p[1] & 0x3f) << 12) |
+          ((uint32_t)(p[2] & 0x3f) << 6) | (p[3] & 0x3f); n = 4;
+      if ((p[1] & 0xc0) != 0x80 || (p[2] & 0xc0) != 0x80 ||
+          (p[3] & 0xc0) != 0x80 || cp < 0x10000 || cp > 0x10ffff)
+        return -1;
+    } else {
+      return -1;
+    }
+    p += n;
+
+    if (cp <= 0xffff) {
+      archive_le16enc(raw + units * 2, (uint16_t)cp);
+      units++;
+    } else {
+      if (units + 2 > 127)
+        break;
+      cp -= 0x10000;
+      archive_le16enc(raw + units * 2, (uint16_t)(0xd800 + (cp >> 10)));
+      archive_le16enc(raw + (units + 1) * 2,
+          (uint16_t)(0xdc00 + (cp & 0x3ff)));
+      units += 2;
+    }
+  }
+  *raw_len = units * 2;
+  return 0;
+}
+
+static int
+rar4_derive_key(const char *password, const uint8_t *salt, size_t salt_len,
+    uint8_t key[16], uint8_t iv[16])
+{
+  struct rar4_sha1 ctx, tmp;
+  uint8_t raw[254 + 8];
+  uint8_t round[3];
+  uint32_t digest[5];
+  size_t raw_len;
+  unsigned i, j;
+
+  if (rar4_password_bytes(password, raw, &raw_len) != 0)
+    return -1;
+  if (salt_len != 0) {
+    memcpy(raw + raw_len, salt, salt_len);
+    raw_len += salt_len;
+  }
+
+  rar4_sha1_init(&ctx);
+  for (i = 0; i < 0x40000; i++) {
+    rar4_sha1_process(&ctx, raw, raw_len, 1);
+    round[0] = (uint8_t)i;
+    round[1] = (uint8_t)(i >> 8);
+    round[2] = (uint8_t)(i >> 16);
+    rar4_sha1_process(&ctx, round, sizeof(round), 0);
+    if ((i & 0x3fff) == 0) {
+      tmp = ctx;
+      rar4_sha1_done(&tmp, digest);
+      iv[i >> 14] = (uint8_t)digest[4];
+    }
+  }
+  rar4_sha1_done(&ctx, digest);
+  for (i = 0; i < 4; i++)
+    for (j = 0; j < 4; j++)
+      key[i * 4 + j] = (uint8_t)(digest[i] >> (j * 8));
+  memset(raw, 0, sizeof(raw));
+  memset(digest, 0, sizeof(digest));
+  return 0;
+}
