+static int
+rar4_datacrypt_start(struct archive_read *a, struct rar *rar)
+{
+  const char *password;
+  size_t salt_len = (rar->file_flags & FHD_SALT) ? sizeof(rar->salt) : 0;
+  int cache_match;
+
+  __archive_read_reset_passphrase(a);
+  password = __archive_read_next_passphrase(a);
+  if (password == NULL || password[0] == '\0') {
+    archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+        "Passphrase required for this entry");
+    return ARCHIVE_FATAL;
+  }
+
+  cache_match = rar->datacrypt.cached_valid &&
+      rar->datacrypt.cached_salt_len == salt_len &&
+      (salt_len == 0 || memcmp(rar->datacrypt.cached_salt, rar->salt,
+          salt_len) == 0) &&
+      strcmp(rar->datacrypt.cached_password, password) == 0;
+  if (cache_match) {
+    memcpy(rar->datacrypt.key, rar->datacrypt.cached_key,
+        sizeof(rar->datacrypt.key));
+    memcpy(rar->datacrypt.iv, rar->datacrypt.cached_iv,
+        sizeof(rar->datacrypt.iv));
+  } else {
+    char *saved_password;
+
+    if (rar4_derive_key(password, (const uint8_t *)rar->salt, salt_len,
+        rar->datacrypt.key, rar->datacrypt.iv) != 0) {
+      archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+          "RAR4 passphrase is not valid UTF-8");
+      return ARCHIVE_FATAL;
+    }
+    saved_password = strdup(password);
+    if (saved_password == NULL) {
+      archive_set_error(&a->archive, ENOMEM,
+          "Cannot cache RAR4 passphrase");
+      return ARCHIVE_FATAL;
+    }
+    free(rar->datacrypt.cached_password);
+    rar->datacrypt.cached_password = saved_password;
+    rar->datacrypt.cached_salt_len = salt_len;
+    if (salt_len != 0)
+      memcpy(rar->datacrypt.cached_salt, rar->salt, salt_len);
+    memcpy(rar->datacrypt.cached_key, rar->datacrypt.key,
+        sizeof(rar->datacrypt.key));
+    memcpy(rar->datacrypt.cached_iv, rar->datacrypt.iv,
+        sizeof(rar->datacrypt.iv));
+    rar->datacrypt.cached_valid = 1;
+  }
+
+  rar->datacrypt.enc_remaining = rar->packed_size;
+  rar->datacrypt.buf_len = 0;
+  rar->datacrypt.buf_pos = 0;
+  rar->datacrypt.active = 1;
+  return ARCHIVE_OK;
+}
+
+static int
+rar4_datacrypt_fill(struct archive_read *a, struct rar *rar, size_t need)
+{
+  size_t avail = rar->datacrypt.buf_len - rar->datacrypt.buf_pos;
+
+  if (avail >= need)
+    return ARCHIVE_OK;
+  if (!rar->datacrypt.ctx_valid) {
+    int ret = archive_decrypto_aes_cbc_init(&rar->datacrypt.ctx,
+        rar->datacrypt.key, sizeof(rar->datacrypt.key), rar->datacrypt.iv);
+    if (ret != 0) {
+      archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+          ret == CRYPTOR_STUB_FUNCTION
+            ? "Decryption is unsupported due to lack of crypto library"
+            : "Failed to initialize RAR4 entry decryption");
+      return ARCHIVE_FATAL;
+    }
+    rar->datacrypt.ctx_valid = 1;
+  }
+
+  if (rar->datacrypt.buf_pos != 0) {
+    memmove(rar->datacrypt.buf,
+        rar->datacrypt.buf + rar->datacrypt.buf_pos, avail);
+    rar->datacrypt.buf_len = avail;
+    rar->datacrypt.buf_pos = 0;
+  }
+
+  if (avail < need) {
+    size_t missing = need - avail;
+    size_t min_cap = avail + ((missing + RAR4_CRYPT_BLOCK - 1) /
+        RAR4_CRYPT_BLOCK) * RAR4_CRYPT_BLOCK;
+    size_t cap = min_cap < RAR4_DATA_WINDOW ? RAR4_DATA_WINDOW : min_cap;
+
+    if (rar->datacrypt.buf_cap < min_cap) {
+      uint8_t *newbuf = realloc(rar->datacrypt.buf, cap);
+      if (newbuf == NULL) {
+        archive_set_error(&a->archive, ENOMEM,
+            "Cannot allocate memory for decrypted RAR4 data");
+        return ARCHIVE_FATAL;
+      }
+      rar->datacrypt.buf = newbuf;
+      rar->datacrypt.buf_cap = cap;
+    }
+  }
+
+  while (rar->datacrypt.buf_len < need) {
+    const uint8_t *p;
+    size_t want = rar->datacrypt.buf_cap - rar->datacrypt.buf_len;
+    size_t out_len;
+
+    if ((int64_t)want > rar->datacrypt.enc_remaining)
+      want = (size_t)rar->datacrypt.enc_remaining;
+    want -= want % RAR4_CRYPT_BLOCK;
+    if (want == 0) {
+      archive_set_error(&a->archive, ARCHIVE_ERRNO_FILE_FORMAT,
+          "Truncated encrypted RAR4 data");
+      return ARCHIVE_FATAL;
+    }
+    p = __archive_read_ahead(a, want, NULL);
+    if (p == NULL)
+      return ARCHIVE_FATAL;
+    out_len = want;
+    if (archive_decrypto_aes_cbc_update(&rar->datacrypt.ctx, p, want,
+        rar->datacrypt.buf + rar->datacrypt.buf_len, &out_len) != 0 ||
+        out_len != want) {
+      archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+          "Failed to decrypt RAR4 entry data");
+      return ARCHIVE_FATAL;
+    }
+    if (want != (size_t)__archive_read_consume(a, (int64_t)want))
+      return ARCHIVE_FATAL;
+    rar->datacrypt.buf_len += want;
+    rar->datacrypt.enc_remaining -= (int64_t)want;
+  }
+  return ARCHIVE_OK;
+}
+
+static int64_t
+rar4_consume(struct archive_read *a, int64_t count)
+{
+  struct rar *rar = a->format->data;
+
+  if (!rar->datacrypt.active)
+    return __archive_read_consume(a, count);
+  if (count < 0 || rar->datacrypt.buf_pos + (size_t)count >
+      rar->datacrypt.buf_len)
+    return -1;
+  rar->datacrypt.buf_pos += (size_t)count;
+  return count;
+}
+
+static void
+rar4_datacrypt_end(struct rar *rar)
+{
+  if (rar->datacrypt.ctx_valid) {
+    archive_decrypto_aes_cbc_release(&rar->datacrypt.ctx);
+    rar->datacrypt.ctx_valid = 0;
+  }
+  rar->datacrypt.active = 0;
+  rar->datacrypt.buf_len = 0;
+  rar->datacrypt.buf_pos = 0;
+  rar->datacrypt.enc_remaining = 0;
+}
+
+static int
+rar4_datacrypt_finish(struct archive_read *a, struct rar *rar)
+{
+  int64_t rest;
+
+  if (!rar->datacrypt.active)
+    return ARCHIVE_OK;
+  rest = rar->datacrypt.enc_remaining;
+  rar4_datacrypt_end(rar);
+  rar->bytes_remaining = 0;
+  rar->bytes_unconsumed = 0;
+  rar->br.avail_in = 0;
+  rar->br.next_in = NULL;
+  if (rest > 0 && __archive_read_consume(a, rest) != rest)
+    return ARCHIVE_FATAL;
+  return ARCHIVE_OK;
+}
